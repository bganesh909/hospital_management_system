# Copy to frontend/.env if you need to change these.

# Dev server port and where the Vite proxy sends /api requests
FRONTEND_PORT=3000
API_PROXY_TARGET=http://localhost:8000

# Only set when the API is on a different origin than the frontend (e.g. production
# without a reverse proxy). Defaults to /api/v1 (same origin).
# VITE_API_BASE_URL=https://api.example.com/api/v1
