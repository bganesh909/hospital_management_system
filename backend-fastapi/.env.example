# Copy to backend-fastapi/.env and fill in. Required values have no defaults.

# Database (required). Must match your Postgres (see root .env for docker-compose)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5433/hospital_db
# Optional: derived from DATABASE_URL when omitted (used by database/migrate.sh)
# DATABASE_URL_SYNC=postgresql://<user>:<password>@localhost:5433/hospital_db
# Optional pool tuning
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10

# JWT (required, at least 32 chars). Generate: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
DEBUG=false
# JSON list. Only needed when the frontend calls the API from another origin
# (not needed in dev, where the Vite proxy is used)
CORS_ORIGINS=["http://localhost:3000"]

# Email (optional; leave SMTP_HOST empty to disable email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Hospital HMS
SMTP_FROM_EMAIL=
